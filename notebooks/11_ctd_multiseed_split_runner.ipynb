{"cells":[{"cell_type":"markdown","metadata":{},"source":["# 11 - CTD multi-seed and split robustness runner\n","\n","This notebook runs a compact, reproducible pilot across random seeds and entity-disjoint split strategies. It compares Vanilla SFT against Distractor-aware SFT and writes a single CSV summary.\n","\n","Default: 3 seeds on the chemical-disjoint split. Set RUN_ALL_SPLITS=True to include gene- and disease-disjoint splits. The goal is reproducibility, not a final full-scale benchmark.\n"]},{"cell_type":"code","metadata":{},"outputs":[],"source":["!pip -q install -U \"transformers>=4.55,<5\" \"datasets>=3.6,<5\" \"peft>=0.17,<1\" \"trl==0.29.1\" \"accelerate>=1.10,<2\" \"bitsandbytes>=0.46,<1\" \"torchao>=0.16,<1\"\n"]},{"cell_type":"code","metadata":{},"outputs":[],"source":["import os, re, random, gc, json\n","import numpy as np\n","import pandas as pd\n","import torch\n","from datasets import Dataset\n","from google.colab import files\n","\n","SEEDS=[1,2,3]\n","RUN_ALL_SPLITS=False\n","SPLITS=[\"chemical\",\"gene\",\"disease\"] if RUN_ALL_SPLITS else [\"chemical\"]\n","MAX_TRAIN=1800\n","MAX_EVAL=100\n","MAX_STEPS=80\n","DISTRACTOR_K=5\n","NO_PATH_K=5\n","MODEL_NAME=\"Qwen/Qwen2.5-0.5B-Instruct\"\n","\n","if not torch.cuda.is_available(): raise RuntimeError(\"Select a GPU runtime in Colab.\")\n","print(\"GPU:\",torch.cuda.get_device_name(0))\n"]},{"cell_type":"code","metadata":{},"outputs":[],"source":["CHEM_GENE=\"/content/CTD_chem_gene_ixns.tsv.gz\"\n","GENE_DISEASE=\"/content/CTD_curated_genes_diseases.tsv.gz\"\n","if not os.path.exists(CHEM_GENE) or not os.path.exists(GENE_DISEASE):\n","    print(\"Upload CTD_chem_gene_ixns.tsv.gz and CTD_curated_genes_diseases.tsv.gz\")\n","    files.upload()\n","assert os.path.exists(CHEM_GENE) and os.path.exists(GENE_DISEASE)\n","\n","chem_cols=[\"ChemicalName\",\"ChemicalID\",\"CasRN\",\"GeneSymbol\",\"GeneID\",\"GeneForms\",\"Organism\",\"OrganismID\",\"Interaction\",\"InteractionActions\",\"PubMedIDs\"]\n","gd_cols=[\"GeneSymbol\",\"GeneID\",\"DiseaseName\",\"DiseaseID\",\"DirectEvidence\",\"InferenceChemicalName\",\"InferenceChemicalID\",\"OmimIDs\",\"PubMedIDs\"]\n","chem=pd.read_csv(CHEM_GENE,sep=\"\\t\",comment=\"#\",header=None,names=chem_cols,dtype=str,low_memory=False)\n","gd=pd.read_csv(GENE_DISEASE,sep=\"\\t\",comment=\"#\",header=None,names=gd_cols,dtype=str,low_memory=False)\n","chem=chem[chem.OrganismID.fillna(\"\").str.strip().eq(\"9606\")].dropna(subset=[\"ChemicalName\",\"ChemicalID\",\"GeneSymbol\",\"GeneID\"]).copy()\n","gd=gd.dropna(subset=[\"GeneID\",\"DiseaseName\",\"DiseaseID\"]).drop_duplicates([\"GeneID\",\"DiseaseID\"]).copy()\n","chem[\"GeneID\"]=chem[\"GeneID\"].str.replace(r\"\\.0$\",\"\",regex=True)\n","gd[\"GeneID\"]=gd[\"GeneID\"].str.replace(r\"\\.0$\",\"\",regex=True)\n","pairs=chem.merge(gd[[\"GeneID\",\"DiseaseName\",\"DiseaseID\"]],on=\"GeneID\",how=\"inner\")\n","pairs=pairs[[\"ChemicalName\",\"ChemicalID\",\"GeneSymbol\",\"GeneID\",\"DiseaseName\",\"DiseaseID\"]].dropna().drop_duplicates([\"ChemicalID\",\"GeneID\",\"DiseaseID\"]).reset_index(drop=True)\n","print(\"2-hop paths:\",len(pairs))\n"]},{"cell_type":"code","metadata":{},"outputs":[],"source":["from transformers import AutoModelForCausalLM, AutoTokenizer\n","from peft import LoraConfig, PeftModel\n","from trl import SFTConfig, SFTTrainer\n","\ntokenizer=AutoTokenizer.from_pretrained(MODEL_NAME)\n","if tokenizer.pad_token is None: tokenizer.pad_token=tokenizer.eos_token\n","tokenizer.padding_side=\"left\"\n","dtype=torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16\n","\ndef render(prompt,answer=None):\n","    msgs=[{\"role\":\"user\",\"content\":prompt}]\n","    if answer is not None: msgs.append({\"role\":\"assistant\",\"content\":answer})\n","    return tokenizer.apply_chat_template(msgs,tokenize=False,add_generation_prompt=answer is None)\n","\ndef norm(s): return re.sub(r\"[^a-z0-9]+\",\" ",str(s).lower()).strip()\n"]},{"cell_type":"code","metadata":{},"outputs":[],"source":["def build_split(df, unit, seed, eval_frac=0.1):\n","    units=df[unit].drop_duplicates().tolist()\n","    rr=random.Random(seed); rr.shuffle(units)\n","    n=max(1,int(eval_frac*len(units)))\n","    eval_units=set(units[:n])\n","    train=df[~df[unit].isin(eval_units)].copy().reset_index(drop=True)\n","    ev=df[df[unit].isin(eval_units)].copy().sample(frac=1,random_state=seed).head(MAX_EVAL).reset_index(drop=True)\n","    return train,ev\n","\n","def clean_prompt(r):\n","    return (f\"Evidence 1: {r.ChemicalName} has a CTD chemical-gene relationship with gene {r.GeneSymbol}.\\n\"\n","            f\"Evidence 2: gene {r.GeneSymbol} is linked to disease {r.DiseaseName}.\\n\"\n","            f\"Question: What disease is connected to {r.ChemicalName} through gene {r.GeneSymbol}? Return Disease: <name> and Path: Chemical -> Gene -> Disease.\")\n","\ndef clean_answer(r): return f\"Disease: {r.DiseaseName}. Path: {r.ChemicalName} -> {r.GeneSymbol} -> {r.DiseaseName}.\"\n","\ndef edge_pool(df): return list({(str(g),str(d)) for g,d in df[[\"GeneSymbol\",\"DiseaseName\"]].itertuples(index=False,name=None)})\n","\ndef distractor_prompt(r,k,pool,rr):\n","    candidates=[x for x in pool if x[0]!=r.GeneSymbol and x[1]!=r.DiseaseName]\n","    if len(candidates)<k: return None\n","    ds=rr.sample(candidates,k); edges=[f\"{r.GeneSymbol} -> {r.DiseaseName}\"]+[f\"{g} -> {d}\" for g,d in ds]; rr.shuffle(edges)\n","    return (f\"Evidence A: {r.ChemicalName} has a CTD chemical-gene relationship with gene {r.GeneSymbol}.\\n\"\n","            +\"Gene-disease evidence:\\n- \"+\"\\n- \".join(edges)\n","            +f\"\\nQuestion: Using only the evidence above, what disease is connected to {r.ChemicalName} through gene {r.GeneSymbol}? Return Disease: <name>.\")\n","\ndef no_path_prompt(r,k,pool,rr):\n","    candidates=[x for x in pool if x[0]!=r.GeneSymbol and x[1]!=r.DiseaseName]\n","    if len(candidates)<k: return None\n","    ds=rr.sample(candidates,k); rr.shuffle(ds)\n","    edges=[f\"{g} -> {d}\" for g,d in ds]\n","    return (f\"Evidence A: {r.ChemicalName} has a CTD chemical-gene relationship with gene {r.GeneSymbol}.\\n\"\n","            +\"Gene-disease evidence:\\n- \"+\"\\n- \".join(edges)\n","            +f\"\\nQuestion: Is there a supported disease path from {r.ChemicalName} through gene {r.GeneSymbol}? Answer either Disease: <name> or No supported path.\")\n","\ndef make_train(df, robust, seed):\n","    rr=random.Random(seed); pool=edge_pool(df); rows=[]\n","    sample=df.sample(min(MAX_TRAIN,len(df)),random_state=seed).reset_index(drop=True)\n","    for r in sample.itertuples(index=False):\n","        if robust and rr.random()<0.5:\n","            p=distractor_prompt(r,DISTRACTOR_K,pool,rr)\n","            if p is not None: rows.append({\"text\":render(p,clean_answer(r))}); continue\n","        rows.append({\"text\":render(clean_prompt(r),clean_answer(r))})\n","    return Dataset.from_list(rows)\n","\ndef make_eval(ev, source, seed):\n","    rr=random.Random(seed+10000); pool=edge_pool(source); out={\"clean\":[],f\"distractor_{DISTRACTOR_K}\":[],f\"no_path_{NO_PATH_K}\":[]}\n","    for r in ev.itertuples(index=False):\n","        base={\"target\":r.DiseaseName,\"gene\":r.GeneSymbol,\"chemical\":r.ChemicalName}\n","        out[\"clean\"].append({**base,\"prompt\":clean_prompt(r),\"kind\":\"positive\"})\n","        p=distractor_prompt(r,DISTRACTOR_K,pool,rr)\n","        if p: out[f\"distractor_{DISTRACTOR_K}\"].append({**base,\"prompt\":p,\"kind\":\"positive\"})\n","        np=no_path_prompt(r,NO_PATH_K,pool,rr)\n","        if np: out[f\"no_path_{NO_PATH_K}\"].append({**base,\"prompt\":np,\"kind\":\"no_path\"})\n","    return out\n"]},{"cell_type":"code","metadata":{},"outputs":[],"source":["def train_adapter(ds,outdir):\n","    model=AutoModelForCausalLM.from_pretrained(MODEL_NAME,dtype=dtype).cuda(); model.config.use_cache=False\n","    lora=LoraConfig(r=8,lora_alpha=16,lora_dropout=0.05,target_modules=[\"q_proj\",\"k_proj\",\"v_proj\",\"o_proj\"],bias=\"none\",task_type=\"CAUSAL_LM\")\n","    args=SFTConfig(output_dir=outdir,per_device_train_batch_size=4,gradient_accumulation_steps=2,max_steps=MAX_STEPS,learning_rate=2e-4,logging_steps=20,save_strategy=\"no\",report_to=\"none\",packing=False,gradient_checkpointing=False,fp16=torch.cuda.is_available() and not torch.cuda.is_bf16_supported(),bf16=torch.cuda.is_available() and torch.cuda.is_bf16_supported())\n","    trainer=SFTTrainer(model=model,args=args,train_dataset=ds,processing_class=tokenizer,peft_config=lora)\n","    trainer.train(); trainer.save_model(outdir); tokenizer.save_pretrained(outdir)\n","    del trainer,model; gc.collect(); torch.cuda.empty_cache()\n","\ndef generate(model,prompts,batch_size=16,max_new_tokens=56):\n","    outs=[]; model.eval()\n","    for s in range(0,len(prompts),batch_size):\n","        enc=tokenizer([render(p) for p in prompts[s:s+batch_size]],return_tensors=\"pt\",padding=True,truncation=True,max_length=384)\n","        enc={k:v.to(model.device) for k,v in enc.items()}\n","        with torch.inference_mode(): out=model.generate(**enc,max_new_tokens=max_new_tokens,do_sample=False,pad_token_id=tokenizer.pad_token_id)\n","        n=enc[\"input_ids\"].shape[1]; outs.extend(tokenizer.batch_decode(out[:,n:],skip_special_tokens=True))\n","    return outs\n","\ndef score(items,preds):\n","    hits=[]\n","    for item,p in zip(items,preds):\n","        q=norm(p)\n","        if item[\"kind\"]==\"no_path\": hits.append(\"no supported path\" in q)\n","        else: hits.append(norm(item[\"target\"]) in q)\n","    return float(np.mean(hits)) if hits else float(\"nan\")\n"]},{"cell_type":"code","metadata":{},"outputs":[],"source":["results=[]\n","for split in SPLITS:\n","    unit={\"chemical\":\"ChemicalID\",\"gene\":\"GeneID\",\"disease\":\"DiseaseID\"}[split]\n","    for seed in SEEDS:\n","        train_df,eval_df=build_split(pairs,unit,seed)\n","        eval_sets=make_eval(eval_df,train_df,seed)\n","        print(f\"\\n=== split={split} seed={seed} train={len(train_df)} eval={len(eval_df)} ===\")\n","        for robust in [False,True]:\n","            label=\"robust\" if robust else \"vanilla\"\n","            adapter=f\"./outputs/11-{split}-{label}-seed{seed}\"\n","            ds=make_train(train_df,robust,seed)\n","            train_adapter(ds,adapter)\n","            base=AutoModelForCausalLM.from_pretrained(MODEL_NAME,dtype=dtype).cuda()\n","            model=PeftModel.from_pretrained(base,adapter); model.eval()\n","            for cond,items in eval_sets.items():\n","                preds=generate(model,[x[\"prompt\"] for x in items])\n","                acc=score(items,preds)\n","                results.append({\"split\":split,\"seed\":seed,\"training\":label,\"condition\":cond,\"accuracy\":acc,\"n\":len(items)})\n","                print(split,seed,label,cond,round(acc,3))\n","            del model,base; gc.collect(); torch.cuda.empty_cache()\n","\n","res_df=pd.DataFrame(results)\n","res_df.to_csv(\"/content/11_results.csv\",index=False)\n","print(\"\\nSaved /content/11_results.csv\")\n"]},{"cell_type":"code","metadata":{},"outputs":[],"source":["summary=(res_df.groupby([\"split\",\"training\",\"condition\"])[\"accuracy\"]\n","         .agg(mean=\"mean\",std=\"std\",n=\"count\")\n","         .reset_index())\n","summary[\"std\"]=summary[\"std\"].fillna(0.0)\n","print(summary.to_string(index=False))\n","summary.to_csv(\"/content/11_summary.csv\",index=False)\n","files.download(\"/content/11_results.csv\")\n","files.download(\"/content/11_summary.csv\")\n"]},{"cell_type":"markdown","metadata":{},"source":["## Interpretation\n","\n","The primary comparison is Vanilla vs Distractor-aware SFT across random seeds and, optionally, chemical/gene/disease-disjoint splits. Report mean +/- standard deviation over seeds.\n","\n","This pilot is deliberately small (`MAX_TRAIN=1800`, `MAX_STEPS=80`). It is for checking reproducibility and split sensitivity. For a paper-quality run, increase training size/steps, add more seeds, and pre-register the final evaluation protocol."]}],"metadata":{"accelerator":"GPU","colab":{"name":"11_ctd_multiseed_split_runner.ipynb","gpuType":"L4"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":5}